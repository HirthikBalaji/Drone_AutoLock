Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /MarkerArray1
        - /Drone Path1
        - /Yacht Path1
        - /Gimbal Camera HUD1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 10
      Class: rviz_default_plugins/Grid
      Color: 30; 70; 110
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ocean Sea Floor Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: world
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /maritime/markers
      Name: Maritime 3D Digital Twin
      Namespaces:
        drone: true
        frustum: true
        hud_text: true
        prediction: true
        vessel: true
        wake: true
      Value: true

    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 140; 0
      Enabled: true
      Head Diameter: 0.3
      Head Symbol:
        Alpha: 1
        Color: 255; 140; 0
        Length: 0.5
        Radius: 0.2
        Value: true
      Length: 0.3
      Line Style: Lines
      Line Width: 0.25
      Name: Drone Accompany Flight Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/path
      Value: true

    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 230; 255
      Enabled: true
      Head Diameter: 0.3
      Head Symbol:
        Alpha: 1
        Color: 0; 230; 255
        Length: 0.5
        Radius: 0.2
        Value: true
      Length: 0.3
      Line Style: Lines
      Line Width: 0.3
      Name: Yacht Sea Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 230; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /yacht/path
      Value: true

    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Gimbal Camera HUD
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/camera/image_locked
      Value: true

  Enabled: true
  Global Options:
    Background Color: 8; 18; 32
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 65.0
      Focal Point:
        X: 25.0
        Y: 10.0
        Z: 6.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Tactical Sea Overview
      Near Clip Distance: 0.01
      Pitch: 0.48
      Target Frame: world
      Value: Orbit (rviz_default_plugins/Orbit)
      Yaw: 2.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 840
  Width: 1400
  X: 100
  Y: 80
